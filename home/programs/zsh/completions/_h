#compdef h

_h () {
    local -a commands
    commands=(
        'build:Build a Nix expression'
        'b:Build a Nix expression'
        'check:Check whether the flake evaluates and run its tests'
        'c:Check whether the flake evaluates and run its tests'
        'rebuild:Rebuild the current system'\''s flake'
        'rb:Rebuild the current system'\''s flake'
        'search:Search nixpkgs for a package'
        's:Search nixpkgs for a package'
        'shell:Run a shell with the specified packages available'
        'sh:Run a shell with the specified packages available'
        'update:Update flake lock file'
        'u:Update flake lock file'
        '--help:Show help'
        '-h:Show help'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands "h commands" commands
        return
    fi

    integer ret=1
    case ${words[2]} in
        b|build)    ;;
        c|check)    _arguments '--impure[Allow impure evaluation]' '*:path:_files' ;;
        rb|rebuild) ;;
        s|search)   ;;
        sh|shell)   ;;
        u|update)   ;;
        *)          _message "Command not found: ${words[2]}" ;;
    esac
    return ret
}

_h
